<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MezziMRS.Api</RootNamespace>
    <!-- Nome dell'eseguibile e quindi del processo in Task Manager / Get-Process.
         Volutamente diverso dal nome del progetto: i namespace restano MezziMRS.Api.* -->
    <AssemblyName>GestionaleMezzi</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="9.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="7.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\MezziMRS.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Script di installazione/rimozione del servizio Windows: finiscono nella
         cartella di publish, allo stesso livello dell'eseguibile (non in una
         sottocartella deploy\). -->
    <Content Include="deploy\**\*.ps1" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
